[sub_resource type="GDScript" id="GDScript_l5k4b"]
script/source = "extends State



signal player_hit
var hit_stager = 12.0
var player_healt = 100
@export var health_bar : ProgressBar
var zombie_damage = 10

func hit(dir) :
	emit_signal(\"player_hit\")
	parent.velocity += clamp(dir * hit_stager , Vector3(1 , 0.0 , 1 ) , Vector3(20.0 , 0.0 , 20.0))
	player_healt -= zombie_damage
	health_bar.value -= zombie_damage
	if player_healt <= 0 :
		get_tree().reload_current_scene()
"

